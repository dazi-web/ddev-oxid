#!/usr/bin/env bash
#ddev-generated
## Description: Install OXID eShop 6 or 7 (guided, or non-interactive via flags)
## Usage: install-oxid [--quick|-y] [--major=6|7] [--version=X] [--edition=ce|pe|ee] [--language=de] [--demo-data|--no-demo-data] [--admin-email=X --admin-password=X|--no-admin] [--license-key=X] [--theme=X] [--shop-url=X]
## Example: ddev install-oxid --quick --major=7
set -e
source /var/www/html/.ddev/oxid/lib.sh

opt_major=""; opt_version=""; opt_edition="ce"; opt_language=""; opt_demo=""; opt_admin_email=""
opt_admin_password=""; opt_no_admin=""; opt_license=""; opt_theme=""; opt_shop_url=""; quick=""
for arg in "$@"; do
  case "$arg" in
    --major=*) opt_major="${arg#*=}" ;;
    --version=*) opt_version="${arg#*=}" ;;
    --edition=*) opt_edition="${arg#*=}" ;;
    --language=*) opt_language="${arg#*=}" ;;
    --demo-data) opt_demo="y" ;;
    --no-demo-data) opt_demo="n" ;;
    --admin-email=*) opt_admin_email="${arg#*=}" ;;
    --admin-password=*) opt_admin_password="${arg#*=}" ;;
    --no-admin) opt_no_admin="y" ;;
    --license-key=*) opt_license="${arg#*=}" ;;
    --theme=*) opt_theme="${arg#*=}" ;;
    --shop-url=*) opt_shop_url="${arg#*=}" ;;
    -y|--yes|--quick) quick="y" ;;
    *) echo "Unbekannte Option: $arg"; exit 1 ;;
  esac
done
opt_admin_password="${opt_admin_password:-$OXID_ADMIN_PASSWORD}"

# Frage stellen: ask <variable> <text> <default>
ask() {
  local reply
  read -p "$2 [$3]: " reply
  printf -v "$1" '%s' "${reply:-$3}"
}

echo "==========================================="
echo "OXID eShop Installation"
echo "==========================================="

# 0. Vorab prüfen, bevor irgendeine Frage kommt
if [ -d htdocs ] && [ -n "$(ls -A htdocs)" ]; then
  if [ -f htdocs/vendor/bin/oe-console ]; then
    echo "Fehler: In htdocs ist bereits OXID installiert."
    echo "Datenbank zurücksetzen: ddev oxid-reset. Für eine Neuinstallation htdocs leeren."
  else
    echo "Fehler: Das Verzeichnis htdocs ist nicht leer."
  fi
  exit 1
fi
if [ -n "${DDEV_DOCROOT+set}" ] && { [ "$DDEV_DOCROOT" != "htdocs/source" ] || { [ -n "$DDEV_WEBSERVER_TYPE" ] && [ "$DDEV_WEBSERVER_TYPE" != "apache-fpm" ]; }; }; then
  echo "Fehler: DDEV läuft mit Docroot '${DDEV_DOCROOT}' und Webserver '${DDEV_WEBSERVER_TYPE}',"
  echo "OXID braucht Docroot 'htdocs/source' und 'apache-fpm'."
  echo "Die Add-on-Konfiguration (.ddev/config.oxid.yaml) greift erst nach einem Neustart:"
  echo "  ddev restart"
  exit 1
fi

# 1. Hauptversion
if [ -z "$opt_major" ] && [ -n "$opt_version" ]; then
  [[ "$opt_version" =~ ^(v?|dev-b-)([67])\. ]] && opt_major="${BASH_REMATCH[2]}"
fi
if [ -z "$opt_major" ]; then
  if [ -n "$quick" ]; then
    opt_major=7
  else
    echo ""
    echo "OXID 7 ist die aktuelle Version. OXID 6 wird nicht mehr gepflegt (nur für Altprojekte)."
    ask opt_major "Hauptversion (6/7)" "7"
  fi
fi
if [ "$opt_major" != "6" ] && [ "$opt_major" != "7" ]; then
  echo "Ungültige Hauptversion: $opt_major (erlaubt: 6, 7)"
  exit 1
fi

if [ "$opt_major" = "6" ]; then
  echo "Hinweis: Für die Installation von OXID 6 wird das Composer-Security-Blocking abgeschaltet (veraltete Abhängigkeiten)."
  export COMPOSER_NO_SECURITY_BLOCKING=1
fi

# 2. Versionen ermitteln
php_version=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
echo ""
echo "Lese verfügbare OXID ${opt_major} Versionen (PHP im Projekt: ${php_version})..."
versions_line=$(composer show oxid-esales/oxideshop-project --all --no-ansi 2>/dev/null | grep '^versions' | cut -d':' -f2)
IFS=',' read -ra version_array <<< "$(echo $versions_line)"

all_versions=()
for ver in "${version_array[@]}"; do
  ver=$(echo $ver | xargs)
  if [[ "$ver" =~ ^(v?${opt_major}\.|dev-b-${opt_major}\.) ]] && { [[ "$ver" != dev-b-* ]] || [[ "$ver" == *-"${opt_edition}" ]]; }; then
    all_versions+=("$ver")
  fi
done
if [ ${#all_versions[@]} -eq 0 ]; then
  echo "Keine ${opt_major}.x Versionen (Edition ${opt_edition}) gefunden."
  exit 1
fi
mapfile -t all_versions < <(printf '%s\n' "${all_versions[@]}" | sort -rV)

# Kurzname und Mindest-PHP einer Version, z.B. dev-b-7.4-ce -> 7.4
version_mm() { [[ "$1" =~ ([67]\.[0-9]+) ]] && echo "${BASH_REMATCH[1]}"; }

shown_versions=(); hidden_count=0
for ver in "${all_versions[@]}"; do
  [[ "$ver" == *beta* || "$ver" == *rc* ]] && continue
  if oxid_php_ok "$(version_mm "$ver")"; then
    shown_versions+=("$ver")
  else
    hidden_count=$((hidden_count + 1))
  fi
done

selected_version=""
if [ -n "$opt_version" ]; then
  found=""
  for ver in "${all_versions[@]}"; do [ "$ver" = "$opt_version" ] && found="y"; done
  if [ -z "$found" ]; then
    echo "Version ${opt_version} ist nicht verfügbar."
    exit 1
  fi
  mm=$(version_mm "$opt_version")
  if ! oxid_php_ok "$mm"; then
    echo "Version ${opt_version} braucht mindestens PHP $(oxid_min_php "$mm"), im Projekt läuft ${php_version}."
    echo "  ddev config --php-version=$(oxid_min_php "$mm") && ddev restart"
    exit 1
  fi
  selected_version="$opt_version"
fi

if [ -z "$selected_version" ]; then
  if [ ${#shown_versions[@]} -eq 0 ]; then
    echo "Keine OXID ${opt_major} Version passt zu PHP ${php_version}. Bitte die PHP-Version anpassen (ddev config --php-version=X)."
    exit 1
  fi
  if [ -n "$quick" ]; then
    selected_version="${shown_versions[0]}"
  else
    echo ""
    echo "Passende Versionen für PHP ${php_version}:"
    i=1
    for ver in "${shown_versions[@]}"; do
      note=""
      [ "$i" = "1" ] && note="  (empfohlen: neueste)"
      echo "  $i) $ver$note"
      i=$((i + 1))
    done
    [ "$hidden_count" -gt 0 ] && echo "  (${hidden_count} weitere Versionen brauchen eine andere PHP-Version und werden nicht angezeigt)"
    while true; do
      ask choice "Version wählen (Enter = empfohlen)" "1"
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#shown_versions[@]} ]; then
        selected_version="${shown_versions[$((choice - 1))]}"
        break
      fi
      echo "Bitte eine Zahl zwischen 1 und ${#shown_versions[@]} eingeben."
    done
  fi
fi
echo "Gewählte Version: ${selected_version}"

# 3. Schnellinstallation oder einzelne Fragen
if [ -z "$quick" ]; then
  echo ""
  echo "Schnellinstallation: Demodaten, Admin-Benutzer mit generiertem Passwort und Standardtheme."
  ask quick_answer "Schnellinstallation verwenden? (j/n)" "j"
  [[ "$quick_answer" =~ ^[JjYy]$ ]] && quick="y"
fi

if [ -n "$opt_shop_url" ]; then
  shop_url="$opt_shop_url"
elif [ -n "${DDEV_PRIMARY_URL}" ]; then
  shop_url="${DDEV_PRIMARY_URL}"
else
  read -p "Shop URL (z.B. http://mein-shop.local): " shop_url
fi

# OXID 6 bringt Deutsch und Englisch mit, die Sprache gilt nur für OXID 7
language="${opt_language:-de}"
if [ "$opt_major" = "7" ] && [ -z "$opt_language" ] && [ -z "$quick" ]; then
  ask language "Sprache (ISO 639-1)" "de"
fi

if [ -n "$opt_demo" ]; then
  install_demo="$opt_demo"
elif [ -n "$quick" ]; then
  install_demo="y"
else
  ask install_demo "Demo-Daten installieren? (j/n)" "j"
fi
[[ "$install_demo" =~ ^[JjYy]$ ]] && install_demo="y" || install_demo="n"

admin_email=""; admin_password=""; admin_generated=""
if [ -z "$opt_no_admin" ]; then
  if [ -n "$opt_admin_email" ] || [ -n "$opt_admin_password" ] || [ -n "$quick" ]; then
    admin_email="${opt_admin_email:-admin@example.com}"
    admin_password="$opt_admin_password"
  else
    ask create_admin "Admin-Benutzer anlegen? (j/n)" "j"
    if [[ "$create_admin" =~ ^[JjYy]$ ]]; then
      ask admin_email "Admin E-Mail" "admin@example.com"
      read -s -p "Admin Passwort (Enter = generieren): " admin_password
      echo ""
    fi
  fi
  if [ -n "$admin_email" ] && [ -z "$admin_password" ]; then
    admin_password=$(oxid_random_password)
    admin_generated="y"
  fi
fi

license_key="$opt_license"
theme_name="$opt_theme"
if [ -z "$quick" ]; then
  [ -z "$license_key" ] && [ "$opt_edition" != "ce" ] && read -p "Lizenzschlüssel (Enter = überspringen): " license_key
  if [ -z "$theme_name" ] && [ "$opt_major" = "7" ]; then
    ask theme_name "Theme" "apex"
  fi
fi

# 4. Installation
echo ""
echo "==========================================="
echo "Erstelle OXID eShop ${selected_version} (das dauert ein bis zwei Minuten)"
echo "==========================================="
if ! composer create-project --no-dev --no-interaction oxid-esales/oxideshop-project htdocs "${selected_version}"; then
  echo "composer create-project ist fehlgeschlagen, räume htdocs auf."
  find htdocs -mindepth 1 -delete 2>/dev/null || true
  echo "Tipp: Passt die PHP-Version (ddev config --php-version=X && ddev restart) oder eine andere --version?"
  exit 1
fi

cd htdocs
echo ""
if [ "$opt_major" = "7" ]; then
  echo "Richte den Shop ein (oe:setup:shop)..."
  ./vendor/bin/oe-console oe:setup:shop \
    --db-host=db --db-port=3306 --db-name=db --db-user=db --db-password=db \
    --shop-url="${shop_url}" \
    --shop-directory="$(pwd)/source" \
    --compile-directory="$(pwd)/source/tmp" \
    --language="${language}"
  if [ "$install_demo" = "y" ]; then
    echo "Installiere Demo-Daten..."
    ./vendor/bin/oe-console oe:setup:demodata
  fi
else
  echo "Richte den Shop ein (OXID 6 hat kein oe:setup:shop, das Setup übernimmt das Add-on)..."
  oxid_setup_legacy "${shop_url}" "${install_demo}"
fi

if [ -n "$admin_email" ]; then
  echo "Erstelle Shop-Administrator..."
  if oxid_has_cmd oe:admin:create-user; then
    ./vendor/bin/oe-console oe:admin:create-user --admin-email="${admin_email}" --admin-password="${admin_password}"
  else
    oxid_admin_sql "${admin_email}" "${admin_password}"
  fi
fi

if [ -n "$license_key" ]; then
  if oxid_has_cmd oe:license:add; then
    ./vendor/bin/oe-console oe:license:add "${license_key}"
  else
    echo "oe:license:add existiert in dieser OXID-Version nicht, Lizenz bitte im Admin eintragen."
  fi
fi

theme_note=""
if oxid_has_cmd oe:theme:activate; then
  theme_name="${theme_name:-apex}"
  ./vendor/bin/oe-console oe:theme:activate "${theme_name}"
  theme_note="Theme: ${theme_name}"
else
  theme_note="Theme: flow (Wechsel im Admin unter Erweiterungen > Themes, OXID 6 kennt kein oe:theme:activate)"
fi
oxid_clear_tmp

# 5. Zusammenfassung
echo ""
echo "==========================================="
echo "Fertig: OXID ${selected_version} ist installiert"
echo "==========================================="
echo "Shop:    ${shop_url}"
echo "Admin:   ${shop_url}/admin/"
if [ -n "$admin_email" ]; then
  echo "Login:   ${admin_email} / ${admin_password}${admin_generated:+  (generiert, bitte notieren)}"
else
  echo "Login:   kein Admin angelegt (ddev oxid-admin <email> <passwort>)"
fi
echo "${theme_note}"
[ "$install_demo" = "y" ] && echo "Demodaten: installiert"
echo ""
echo "Nützliche Befehle:"
echo "  ddev launch          Shop im Browser öffnen"
echo "  ddev oxid-cc         Cache leeren"
echo "  ddev oxid-log        Log verfolgen"
echo "  ddev oxid-module     Module aktivieren/deaktivieren"
echo "  ddev oxid-update     Shop aktualisieren"
