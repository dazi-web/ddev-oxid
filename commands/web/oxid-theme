#!/usr/bin/env bash
#ddev-generated
## Description: Activate an OXID theme (OXID 7 only; OXID 6 switches themes in the admin)
## Usage: oxid-theme [theme-id]
## Example: ddev oxid-theme apex
source /var/www/html/.ddev/oxid/lib.sh
theme="${1:-$(oxid_default_theme)}"
if ! oxid_console_or_explain oe:theme:activate "$theme"; then
  echo "In OXID $(oxid_major) wird das Theme im Admin gewechselt (Erweiterungen > Themes, z.B. flow oder wave)."
  exit 1
fi
