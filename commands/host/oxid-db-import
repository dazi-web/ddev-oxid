#!/usr/bin/env bash
#ddev-generated
## Description: Import a dump from .ddev/db-dumps (default: the newest one)
## Usage: oxid-db-import [file]
## Example: ddev oxid-db-import
set -e
file="$1"
if [ -z "$file" ]; then
  file=$(ls -t "${DDEV_APPROOT}"/.ddev/db-dumps/*.sql.gz 2>/dev/null | head -n1)
fi
[ -n "$file" ] && [ -f "$file" ] || { echo "No dump found."; exit 1; }
echo "Importing $file"
ddev import-db --file="$file"
